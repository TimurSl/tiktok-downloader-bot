# Required
BOT_TOKEN=your_bot_token_here

# Optional access control. Empty means everyone can use the bot.
# Supported group media links are still handled for non-authorized users.
AUTHORIZED_USER=your_telegram_user_id,friend_id_here

# Optional admins: may use /stats and get a message when something breaks unexpectedly.
ADMIN_USER=your_telegram_user_id

# Runtime paths (the work dir also stores chat settings and the file_id cache)
BOT_WORK_DIR=/tmp/tiktok-downloader-bot
BOT_DOWNLOAD_DIR=/tmp/tiktok-downloader-bot/downloads

# Telegram API
BOT_API_BASE=https://api.telegram.org
BOT_MAX_UPLOAD_MB=50
BOT_POLL_TIMEOUT=50

# Concurrency
BOT_MAX_WORKERS=4
BOT_USER_CONCURRENCY=2
BOT_MAX_LINKS=3

# yt-dlp
YTDLP_FORMAT=bv*+ba/best
YTDLP_NO_PLAYLIST=true
YTDLP_COOKIES=
YTDLP_COOKIES_FROM_BROWSER=

# Only needed for inline mode (@bot <link> in any chat). Use a private channel/group
# where the bot can post: files are uploaded there once to obtain a reusable file_id.
TELEGRAM_CACHE_CHAT_ID=

# Logging
LOG_LEVEL=INFO
