# Telegram Bot Configuration (Required)
APP_ID=your_telegram_api_id_here
APP_HASH=your_telegram_api_hash_here
BOT_TOKEN=your_bot_token_here
OWNER=your_telegram_user_id
AUTHORIZED_USER=your_telegram_user_id,friend_id_here

# Database Configuration
DATABASE_URL=sqlite:///bot.db
REDIS_URL=redis://localhost:6379

# Bot Settings
WORKERS=50
ENABLE_FFMPEG=True
AUDIO_FORMAT=mp3
VIDEO_FORMAT=mp4
FREE_DOWNLOAD=50
RATE_LIMIT=5
TG_NORMAL_MAX_SIZE=2000
TMPFILE_PATH=/tmp/telegram-bot

# Full automation bot settings (bots/automation_bot.py or nix run .)
BOT_WORK_DIR=/tmp/telegram-automation-bot
BOT_DOWNLOAD_DIR=/tmp/telegram-automation-bot/downloads
BOT_DATABASE=/tmp/telegram-automation-bot/bot.sqlite3
BOT_API_BASE=https://api.telegram.org
BOT_MAX_UPLOAD_MB=50
BOT_POLL_TIMEOUT=50
YTDLP_FORMAT=bv*+ba/best
YTDLP_NO_PLAYLIST=true
YTDLP_COOKIES=
YTDLP_COOKIES_FROM_BROWSER=

# Required for guest-mode media downloads. Use a private channel/group where
# the bot can post cache messages; the bot reuses the returned Telegram file_id.
TELEGRAM_CACHE_CHAT_ID=

# Optional Settings
LOG_LEVEL=INFO
DEBUG_MODE=False
